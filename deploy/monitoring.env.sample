# Dedicated probe configuration, root-owned; contains no application credentials.
MONITORING_STATE_DIR=/var/lib/12-week-dashboard-monitoring
# Empty means explicitly not configured. Only these IDs are accepted:
MONITORING_TIMERS=weekly,reminders,broost
# Fixed choice: standard or standalone-blob. Include backup in MONITORING_TIMERS to observe it.
MONITORING_BACKUP_TIMER=standard
# Optional fixed local PUBLIC leaf certificate, not the private key.
# Must be a regular file (final-component symlinks are rejected).
# MONITORING_CERT_FILE=/etc/12-week-dashboard-monitoring/leaf.pem
# Enable only after successful backup completion is wired to the receipt writer.
MONITORING_FILE_BACKUP_ENABLED=false
MONITORING_CLOUD_BACKUP_ENABLED=false
