[Unit]
Description=12-Week Year Dashboard — end-of-week scoreboard recap email (one-shot)
After=network.target

[Service]
Type=oneshot
User=copilot-agent
Group=copilot-agent
WorkingDirectory=/opt/12-week-dashboard/server
EnvironmentFile=/opt/12-week-dashboard/server/.env
ExecStart=/snap/node/current/bin/node dist/sendWeekRecapEmails.js
# Must stay comfortably below the delivery worker's 10-minute stale-claim lease
# (STALE_LEASE_MINUTES in server/src/lib/weekRecap.ts) — if a run is still starting up (or
# hung) past this, systemd kills it well before another invocation could otherwise treat its
# claims as abandoned and start reclaiming them concurrently.
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Must match the actual deployed DATA_DIR/DB_FILE from .env, and must be the *directory*
# containing the SQLite file — not just the file itself — since WAL mode also writes
# sidecar `-wal`/`-shm` files alongside it that this service must be able to create/modify.
ReadWritePaths=/var/lib/12-week-dashboard
ProtectHome=true
