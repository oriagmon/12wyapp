# Operator-only /etc/12-week-dashboard-backup-cloud.env, root-owned mode 0600.
# No account keys, connection strings, SAS tokens, client secrets or application .env.
# Leave disabled until the parent's private storage/RBAC/budget/security checks are complete.
AZURE_BACKUP_ENABLED=false
AZURE_BACKUP_ACCOUNT=
AZURE_BACKUP_CONTAINER=
# Compressed bytes: default 128 MiB; enforced maximum 256 MiB (268435456).
AZURE_BACKUP_MAX_BYTES=134217728
# Optional GUID for an explicitly attached user-assigned identity. Empty = VM system identity.
AZURE_BACKUP_MANAGED_IDENTITY_CLIENT_ID=
