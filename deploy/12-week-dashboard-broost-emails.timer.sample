[Unit]
Description=Claim and send due BROOST emails (every minute)

[Timer]
# Fires at the top of every minute — most BROOSTs are already sent immediately after creation
# (see routes/broosts.ts); this timer is the safety-net catch-all for anything still due
# (a backoff retry, or a process that was down at creation time).
OnCalendar=*-*-* *:*:00
# If the machine was off/asleep at a scheduled minute, run once shortly after boot instead of
# silently skipping any BROOSTs that became due while it was down.
Persistent=true
AccuracySec=1sec

[Install]
WantedBy=timers.target
