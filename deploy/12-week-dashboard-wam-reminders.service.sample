[Unit]
Description=12-Week Year Dashboard — weekly WAM reminder email (one-shot)
After=network.target

[Service]
Type=oneshot
User=copilot-agent
Group=copilot-agent
WorkingDirectory=/opt/12-week-dashboard/server
EnvironmentFile=/opt/12-week-dashboard/server/.env
ExecStart=/snap/node/current/bin/node dist/sendWamReminders.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/12-week-dashboard
ProtectHome=true
