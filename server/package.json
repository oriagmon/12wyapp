{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations dist/assets && cp src/migrations/*.sql dist/migrations/ && cp src/assets/* dist/assets/",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "send-wam-reminders": "tsx src/sendWamReminders.ts",
    "send-scheduled-reminders": "tsx src/sendScheduledReminders.ts",
    "send-broost-emails": "tsx src/sendBroostEmails.ts",
    "send-week-milestone-emails": "tsx src/sendWeekMilestoneEmails.ts",
    "evidence-maintenance": "tsx src/evidenceMaintenance.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
