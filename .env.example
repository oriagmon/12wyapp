# Host/port the Node server binds to. Keep on localhost/127.0.0.1 unless you
# terminate TLS in front with a reverse proxy (see deploy/nginx.conf.sample).
HOST=127.0.0.1
PORT=4000
NODE_ENV=production

# Required in production: comma-separated existing users.id values explicitly approved by
# the operator. Never auto-populate from all users or email addresses. Blank/malformed
# values fail startup. Public signup is always disabled in production and whenever this
# setting exists. For open isolated development fixtures, OMIT the setting entirely.
APP_ALLOWED_USER_IDS=

# Directory for the persistent SQLite database file. Must be writable by the
# process user and survive restarts/deploys (do not point this at a tmpfs).
DATA_DIR=./data
DB_FILE=app.sqlite

# Directory tactic-evidence files (photos/PDFs/DOCX/TXT attached to a completed tactic
# occurrence) are stored on disk — file bytes are never stored in SQLite. Defaults to
# <DATA_DIR>/evidence if unset, so a default install needs no extra configuration; only set
# this if you want evidence files on a different volume/path than the database. Must be
# writable by the process user and survive restarts/deploys, exactly like DATA_DIR. Example
# production path if kept separate: /var/lib/12-week-dashboard/evidence
# The server automatically creates/tightens this directory to owner-only 0700 (and every
# written file to 0600) at startup and before every write — no manual chmod needed.
EVIDENCE_DIR=

# How long a login session cookie stays valid, in days.
SESSION_TTL_DAYS=30

# --- Weekly WAM email reminders (Tuesday 10:00 Asia/Jerusalem via systemd timer, see
# deploy/12-week-dashboard-wam-reminders.timer.sample) — only required to run
# `npm run send-wam-reminders` / `node dist/sendWamReminders.js` — and scheduled one-time
# email reminders (every minute via systemd timer, see
# deploy/12-week-dashboard-scheduled-reminders.timer.sample) — only required to run
# `npm run send-scheduled-reminders` / `node dist/sendScheduledReminders.js` — and BROOST
# partner-encouragement emails (also every minute via systemd timer as a safety-net
# catch-all, see deploy/12-week-dashboard-broost-emails.timer.sample) — only required to run
# `npm run send-broost-emails` / `node dist/sendBroostEmails.js`. These same three vars are
# ALSO used directly by the main web server itself for the password-reset ("forgot password")
# email and every BROOST's immediate post-send delivery attempt — the live server (not just a
# standalone CLI) sends email in both of those cases. If unset, forgot-password requests still
# succeed (same generic response) and BROOSTs still save successfully in-app, but both
# silently fail to actually send their email (logged server-side only). ---

# Azure Communication Services "Keys" connection string for the Email resource, e.g.
# endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
ACS_EMAIL_CONNECTION_STRING=

# Verified sender address from the ACS Email domain (e.g. 12wyapp@<id>.azurecomm.net),
# or a verified custom domain sender.
EMAIL_SENDER_ADDRESS=

# Required HTTPS public URL in production. Its EXACT origin is the only browser origin
# permitted for API requests/CORS; sibling hosts, wildcards and Origin:null are not trusted.
# Also used in reminder/password-reset email links. Restart after changing either policy.
APP_PUBLIC_URL=https://your-app.example.com/

# Optional read-only operational observations. This directory is owned by the
# separate root-run monitoring probe; never make it writable by the application.
MONITORING_STATE_DIR=
MONITORING_PROBE_MAX_AGE_SECONDS=900
MONITORING_BACKUP_MAX_AGE_SECONDS=129600
